import pandas as pd
from pathlib import Path

configfile: "config/config.yaml"

# ── Sample table ───────────────────────────────────────────────────────────────
# Supported columns:
#   sample | r1 | r2            → QC + assembly + viral detection + abundance
#   sample | contigs            → viral detection only (no QC, assembly, or abundance)
#   sample | r1 | r2 | contigs  → use provided contigs but still run QC for abundance

samples_df = pd.read_csv(config.get("samples", "config/samples.tsv"), sep="\t", index_col="sample", dtype=str)
SAMPLES = samples_df.index.tolist()

# Sample names become contig-ID prefixes ("{sample}__k141_N"), so "__" and
# whitespace would make sample_of_origin ambiguous. Fail at parse time.
_bad = [s for s in SAMPLES if "__" in s or any(c.isspace() for c in s) or not s]
if _bad:
    raise ValueError(f"Sample names must be non-empty, without whitespace or '__': {_bad}")
if len(set(SAMPLES)) != len(SAMPLES):
    raise ValueError("Duplicate sample names in the sample sheet")

# Samples that need fastp QC (have reads)
READS_SAMPLES = [
    s for s in SAMPLES
    if "r1" in samples_df.columns and pd.notna(samples_df.loc[s].get("r1", float("nan")))
]

# Samples that need de-novo assembly (have reads but no provided contigs)
ASSEMBLE_SAMPLES = [
    s for s in READS_SAMPLES
    if not ("contigs" in samples_df.columns and pd.notna(samples_df.loc[s].get("contigs", float("nan"))))
]


def get_r1(wildcards):
    return samples_df.loc[wildcards.sample, "r1"]

def get_r2(wildcards):
    return samples_df.loc[wildcards.sample, "r2"]

def get_raw_contigs(wildcards):
    """Assembled or user-provided contigs, before length gating / renaming."""
    row = samples_df.loc[wildcards.sample]
    if "contigs" in samples_df.columns and pd.notna(row.get("contigs", float("nan"))):
        return str(row["contigs"])
    return f"results/samples/{wildcards.sample}/assembly/{wildcards.sample}_contigs.fa"

def get_contigs_path(sample):
    """Length-gated contigs with canonical '{sample}__<id>' headers (prep_contigs)."""
    return f"results/samples/{sample}/contigs/{sample}_contigs.fa"

def get_contigs(wildcards):
    return get_contigs_path(wildcards.sample)


